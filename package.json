{
  "name": "editwell",
  "version": "0.2.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./ && npm run build:library",
    "preview": "vite preview",
    "build:library": "vite build --config vite.library.config.js && node scripts/notices.js",
    "test": "node --test --test-concurrency=1 tests/editor.test.js"
  },
  "keywords": [],
  "author": "",
  "description": "Standalone rich text editor with configurable toolbars, themes and plugins",
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "dompurify": "^3.4.18"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "vite": "^8.3.8"
  },
  "type": "module",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./lib/editwell.js"
    },
    "./style.css": "./lib/editwell.css"
  },
  "files": [
    "lib",
    "LICENSE",
    "README.md"
  ]
}
